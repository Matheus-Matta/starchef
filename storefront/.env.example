# Storefront (Nuxt) — variaveis de ambiente
#
# Em desenvolvimento, copie para `.env`:
#   cp .env.example .env

# Backend Django. O renderer publico usa so /api/v1/public/**; o editor usa
# /api/v1/storefront/** com o cookie proprio dele (`sf_access`/`sf_refresh`),
# separado do cookie do painel administrativo.
STOREFRONT_API_BASE=http://localhost:8001

# Porta do dev server (o frontend Vite usa 5173, o backend Django usa 8001).
PORT=3100

# NAO existe mais variavel de "qual restaurante". O site e escolhido pelo
# PRIMEIRO SEGMENTO da URL, e o slug de MenuSite e unico na plataforma:
#
#   http://localhost:3100/burger/            -> site do Burger Palace
#   http://localhost:3100/pizzapalace/       -> site de outro restaurante
#   http://localhost:3100/burger/editor/     -> editor (pede login)
#
# Com ou sem a barra no final, tanto faz. Para listar os slugs existentes:
#   python manage.py shell -c "from apps.storefront.models import MenuSite; print(*MenuSite.all_objects.values_list('slug', flat=True))"
