.env
# Os `.env` preenchidos da sincronização: senha do banco da loja, segredo de
# matrícula e, depois do primeiro boot, o token e a chave do nó. Só os
# `*.example` são versionados.
.env.local
.env.cloud
docker/local/.env.local
docker/local/.env.cloud
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
backend/makemigrations-trace.txt

backend/media/
backend/staticfiles/
backend/db.sqlite3
backend/db*.sqlite3
backend/test.sqlite3
test.sqlite3
# Arquivos-irmaos do modo WAL do SQLite (ver docs/BACKEND.md). Aparecem ao lado
# de todo banco local desde que o WAL foi ligado; versiona-los corromperia a
# copia de quem clonasse.
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

frontend/node_modules/
frontend/dist/

postgres_data/
redis_data/
backups/*.sql
backups/*.dump
artifacts/

.DS_Store
Thumbs.db

afazer/

infra/simuladores/impressoes/
infra/simuladores/logs/

logs/

# Chaves de assinatura Android, em QUALQUER pasta. O pdv_mobile/android/ já
# tinha a própria regra, mas um .jks gerado um nível acima (ao rodar o keytool
# da pasta errada) escapava dela — e este repositório é público.
*.jks
*.keystore
key.properties
