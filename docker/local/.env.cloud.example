# .env.cloud — o que ADICIONAR ao `.env` do backend da nuvem para ele aceitar
# as lojas. Não é um `.env` completo: é o bloco de sincronização.
#
# A nuvem é o mesmo backend, a mesma imagem e as mesmas migrations da loja. A
# diferença é `SYNC_NODE_TYPE=cloud`: ela RECEBE conexões em /ws/sync/v1/ em
# vez de abrir uma.

SYNC_ENABLED=true
# Nesta fase o código recusa qualquer outro valor.
SYNC_ENVIRONMENT=development
SYNC_NODE_TYPE=cloud
SYNC_APP_VERSION=3.0.8

# A chave AES usada no payload das mensagens deste ambiente. Gere com:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# O banco guarda só o `key_id` e a impressão digital — a chave pura vive aqui.
SYNC_ENCRYPTION_KEY=
SYNC_ENCRYPTION_KEY_ID=dev-key-01

SYNC_BATCH_MAX_EVENTS=200
SYNC_BATCH_MAX_BYTES=1048576
SYNC_RETENTION_DAYS=30

# Limite da rota de matrícula. Ela aceita usuário e senha no corpo, então é
# alvo de força bruta como qualquer login — e uma instalação legítima faz isso
# uma vez na vida.
THROTTLE_RATE_SYNC_ENROLL=5/hour

# Teto do binário aceito por transferência de arquivo (§16).
SYNC_FILE_MAX_BYTES=67108864
# Token de raspagem das métricas. Vazio = só superusuário; nunca aberta.
SYNC_METRICS_TOKEN=

# A nuvem também precisa das triggers da rede de segurança. Rode depois do
# migrate, em todo deploy (é idempotente):
#   docker compose exec backend python manage.py sync_install_triggers

# A nuvem NÃO precisa destas: identidade de nó local, token e matrícula são da
# loja. Deixe-as fora do `.env` da nuvem de propósito.
#   SYNC_NODE_ID / SYNC_AUTH_TOKEN / SYNC_ENROLL_* / SYNC_CLOUD_WSS_URL
#
# O proxy reverso da nuvem precisa encaminhar o WebSocket em /ws/sync/v1/ com
# `Upgrade`/`Connection` preservados — sem isso o handshake nunca acontece e o
# sintoma é a loja "tentando conectar" para sempre.
