                                        # .env.local — o backend da LOJA.
#
# Copie para `.env.local` e preencha. NÃO versione o arquivo preenchido: ele
# contém a senha do banco e o segredo de matrícula.
#
#   cp .env.local.example .env.local
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d
#
# O que diferencia esta instalação da nuvem são DUAS linhas: SYNC_NODE_TYPE e
# as credenciais do nó. O resto é um backend StarChef comum.
#
# `SYNC_NODE_TYPE` NÃO decide sozinho a faixa de numeração de pedido. Quem
# decide é o `SyncNode` gravado por `sync_install_node` — ver a seção de
# sincronização mais abaixo.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_ENV=production
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-de-pelo-menos-50-caracteres
DJANGO_DEBUG=False
# Adicione o IP/hostname do servidor da loja na rede interna.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,pdv.loja.local,192.168.0.10
DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.0.10:8000,http://pdv.loja.local:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8000,http://pdv.loja.local:8000

# HTTP puro na rede interna da loja: não há proxy TLS na frente. Se você
# colocar um, ligue estas três de volta.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_AUTH_COOKIE_SECURE=False

# ── PostgreSQL da loja ───────────────────────────────────────────────────────
USE_SQLITE_DATABASE=False
POSTGRES_DB=starchef_local
POSTGRES_USER=starchef
POSTGRES_PASSWORD=troque-esta-senha
# Pool nativo: workers × POSTGRES_POOL_MAX tem de caber no max_connections.
POSTGRES_POOL=True
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=8

# ── Redis ────────────────────────────────────────────────────────────────────
USE_LOCAL_MEMORY_SERVICES=False
REDIS_MAXMEMORY=192mb

# ── Recursos do host (uma máquina modesta dentro do restaurante) ─────────────
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
BACKEND_MEM_LIMIT=1g
CELERY_WORKER_MEM_LIMIT=768m
SYNC_WORKER_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m

# A porta que o PDV e os tablets acessam. 0.0.0.0 porque eles são outras
# máquinas — restrinja no firewall do host à faixa interna do restaurante.
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000
# A imagem da loja e a MESMA da nuvem — o papel do no e configuracao, nao
# build. Fixe a versao do release que a nuvem esta rodando: as duas pontas
# precisam falar o mesmo protocolo (`PROTOCOL_VERSION`), e o handshake recusa
# versoes incompativeis em vez de tentar adivinhar.
BACKEND_IMAGE=ghcr.io/matheus-matta/starchef-backend:3.0.14

# ═════════════════════════════════════════════════════════════════════════════
#  SINCRONIZAÇÃO COM A NUVEM
# ═════════════════════════════════════════════════════════════════════════════
SYNC_ENABLED=true
# `development` ou `production`, e nada mais — `prod` é recusado com exceção,
# não vira um terceiro ambiente. Precisa ser IGUAL ao da nuvem: o ambiente faz
# parte da identidade do nó e é conferido no HELLO, e é isso que impede esta
# loja mandar venda de teste para o banco que vale.
# Para virar de um para outro sem derrubar as lojas, veja
# `manage.py sync_set_environment` (na nuvem).
SYNC_ENVIRONMENT=development
# O papel deste nó. A loja é `local`; a nuvem é `cloud`.
#
# ELE NÃO ESCOLHE MAIS A FAIXA DE NUMERAÇÃO DE PEDIDO SOZINHO. Quem escolhe é
# o `SyncNode` que `sync_install_node` grava no banco — a loja numera a partir
# de 1, a nuvem a partir de 1.000.000, e as duas nunca se encontram.
#
# A ordem é essa porque já custou: uma loja com `cloud` aqui passava a numerar
# na faixa alta, ela e a nuvem entregavam os MESMOS números, e a sincronização
# juntava duas vendas diferentes com o mesmo "pedido 1.000.002". O primeiro
# sintoma era outro — pedido nascendo com sete dígitos numa loja que nunca
# passou de três.
#
# Errar esta linha hoje não muda a numeração: ela passa a discordar do banco e
# o `manage.py check` acusa (synchronization.W008). Mas o RESTO da
# sincronização ainda lê daqui, então mantenha certo.
SYNC_NODE_TYPE=local
SYNC_APP_VERSION=3.0.14

# O nome desta loja como ela aparece no Admin da nuvem, na lista de nós.
# É por aqui que se diferencia uma instalação da outra — deixar vazio faz toda
# loja aparecer como "Servidor da loja", e aí não dá para saber qual é qual.
#
# Trocar aqui e rematricular RENOMEIA o nó existente; não cria um segundo.
# Também dá para renomear direto no Admin da nuvem.
SYNC_NODE_NAME=Loja Centro

# ── Matrícula automática (primeira subida) ───────────────────────────────────
# Com isto ligado, o sync_worker se apresenta à nuvem no primeiro boot, recebe
# as credenciais CIFRADAS e a nuvem já enfileira a carga total. Não é preciso
# copiar token à mão.
#
# Depois da primeira matrícula você pode apagar SYNC_ENROLL_PASSWORD e
# SYNC_ENROLL_SECRET daqui: as credenciais definitivas já estarão gravadas em
# SYNC_ENROLL_ENV_PATH, e o worker passa a usá-las.
SYNC_AUTO_ENROLL=true
SYNC_CLOUD_API_URL=https://dev-nuvem.exemplo.com
SYNC_CLOUD_WSS_URL=wss://dev-nuvem.exemplo.com/ws/sync/v1/
SYNC_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# Restaurante desta loja. Vazio = a conta inteira desce para cá.
SYNC_STORE_ID=

# Quem autoriza a matrícula deste servidor. NÃO precisa ser superadmin da
# plataforma: um usuário cujo perfil é da conta em SYNC_ACCOUNT_ID e cujo papel
# é "Administrador" (`is_account_admin`) basta, e é a escolha melhor — ele só
# consegue matricular nó NA PRÓPRIA CONTA, enquanto um superadmin poderia
# matricular em qualquer uma. Se a senha desta loja vazar, o estrago fica
# contido à conta dela.
SYNC_ENROLL_USERNAME=admin
SYNC_ENROLL_PASSWORD=
# Segredo combinado, mínimo 24 caracteres. Ele cifra o pacote de credenciais na
# volta — NÃO é a chave de sincronização, que nasce na nuvem e vem dentro do
# pacote. Use um valor diferente por loja e não o reaproveite.
SYNC_ENROLL_SECRET=

# Onde gravar as credenciais recebidas. O caminho é o volume `sync_credentials`
# do compose: sem ele, reiniciar o container perderia o token.
SYNC_ENROLL_ENV_PATH=/app/sync/credentials.env

# ── Credenciais do nó (preenchidas pela matrícula) ───────────────────────────
# Deixe VAZIAS na primeira subida. Se você provisionou à mão na nuvem
# (`manage.py sync_provision_node`), cole aqui o pacote que ele imprimiu e
# desligue SYNC_AUTO_ENROLL.
SYNC_NODE_ID=
SYNC_PAIR_ID=
SYNC_PEER_NODE_ID=
SYNC_AUTH_TOKEN=
SYNC_ENCRYPTION_KEY=
SYNC_ENCRYPTION_KEY_ID=

# ── Ajuste fino da sincronização ─────────────────────────────────────────────
# Teto do lote: o que estourar primeiro corta. Um pedido com cem itens não
# pode virar uma mensagem de 20 MB.
SYNC_BATCH_MAX_EVENTS=200
SYNC_BATCH_MAX_BYTES=1048576
# Retenção. Só apaga evento JÁ CONFIRMADO pela nuvem; o que falhou fica.
SYNC_RETENTION_DAYS=30
SYNC_INTERVAL=2
SYNC_HEARTBEAT=20
# Teto do binário por transferência (imagem, XML, PDF). Um upload de 2 GB por
# engano enche o disco da loja antes de alguém perceber.
SYNC_FILE_MAX_BYTES=67108864
# Token de raspagem do /api/v1/sync/metrics/. Vazio = só superusuário acessa;
# a rota nunca fica aberta.
SYNC_METRICS_TOKEN=

# ── Mídia ────────────────────────────────────────────────────────────────────
# Vazio = disco local (volume backend_media). A loja normalmente não fala com
# o S3 — as imagens descem pelo canal de arquivos da sincronização.
AWS_STORAGE_BUCKET_NAME=
