# .env.local — o StarChef da LOJA.
#
# O jeito fácil: rode `instalar.ps1` (Windows) ou `instalar.sh` (Linux). Ele
# copia este arquivo para `.env.local`, gera as senhas e pergunta o IP.
#
# À mão:
#   cp .env.local.example .env.local      (e preencha o bloco OBRIGATÓRIO)
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d
#
# NÃO versione o `.env.local` preenchido: ele tem a senha do banco e a chave do
# Django. (Ele já está no .gitignore.)

# ═════════════════════════════════════════════════════════════════════════════
#  OBRIGATÓRIO — sem estes quatro o compose nem sobe, e diz qual falta
# ═════════════════════════════════════════════════════════════════════════════

# A versão do StarChef (a mesma tag da nuvem, sem o "v"). As duas pontas
# precisam falar o mesmo protocolo de sincronização, e o handshake recusa
# versões incompatíveis. Atualizar a loja = trocar aqui e dar `up -d`.
STARCHEF_VERSION=latest

# O endereço deste servidor NA REDE DA LOJA — o que o PDV, os tablets e o
# navegador vão usar. Um IP fixo é o mais seguro (reserve no roteador).
# Exemplo: com 192.168.0.10, o painel abre em http://192.168.0.10/ e o PDV
# aponta para http://192.168.0.10/api/v1
STORE_HOST=192.168.0.10

# Chave do Django: longa e aleatória. O instalador gera sozinho. À mão:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Senha do banco da loja. O banco só é acessível de dentro do compose, mas
# continua sendo o banco com as vendas: use uma senha forte.
POSTGRES_PASSWORD=

# Token do PRIMEIRO ACESSO: com ele, http://IP/admin/ cria a conta e o primeiro
# administrador. Só serve para loja SEM sincronização (a conta e os usuários
# da loja sincronizada descem da nuvem). O instalador gera e mostra no fim.
# Depois do primeiro acesso a tela some sozinha; pode apagar o valor.
DJANGO_FIRST_ACCESS_TOKEN=

# ═════════════════════════════════════════════════════════════════════════════
#  SINCRONIZAÇÃO COM A NUVEM (opcional)
# ═════════════════════════════════════════════════════════════════════════════
# `false` = a loja opera sozinha, sem nuvem. `true` = conversa com a nuvem:
# cadastros descem, vendas sobem. Ligar depois é mudar aqui e dar `up -d`.
SYNC_ENABLED=false

# `development` ou `production`, IGUAL ao da nuvem. É parte da identidade do
# nó, conferida no HELLO: é o que impede venda de teste ir para o banco que vale.
SYNC_ENVIRONMENT=production

# Como esta loja aparece na lista de nós do Admin da nuvem.
SYNC_NODE_NAME=Loja Centro

# Matrícula automática: na primeira subida o sync_worker se apresenta à nuvem,
# recebe as credenciais CIFRADAS e a carga total já começa a descer.
SYNC_AUTO_ENROLL=true
SYNC_CLOUD_API_URL=https://api.starchef.com.br
SYNC_CLOUD_WSS_URL=wss://api.starchef.com.br/ws/sync/v1/
# A conta (UUID) e, se quiser só uma unidade, o restaurante (UUID).
SYNC_ACCOUNT_ID=
SYNC_STORE_ID=
# Um ADMINISTRADOR DA CONTA (não precisa ser superadmin): ele só matricula nó
# na própria conta, e se a senha vazar o estrago fica contido a ela.
SYNC_ENROLL_USERNAME=
SYNC_ENROLL_PASSWORD=
# Segredo de matrícula, mínimo 24 caracteres, diferente por loja. Ele só cifra
# o pacote de credenciais na volta; NÃO é a chave de sincronização. O
# instalador gera sozinho. Depois da matrícula pode apagar a senha e este.
SYNC_ENROLL_SECRET=

# Credenciais do nó: deixe VAZIAS. A matrícula as grava no volume
# `sync_credentials`. Só preencha se provisionou à mão na nuvem
# (`manage.py sync_provision_node`) — e aí desligue SYNC_AUTO_ENROLL.
SYNC_NODE_ID=
SYNC_PAIR_ID=
SYNC_PEER_NODE_ID=
SYNC_AUTH_TOKEN=
SYNC_ENCRYPTION_KEY=
SYNC_ENCRYPTION_KEY_ID=

# ═════════════════════════════════════════════════════════════════════════════
#  AJUSTES (opcional — os padrões servem para a maioria das lojas)
# ═════════════════════════════════════════════════════════════════════════════

# Portas. A 80 é a porta única (painel + API). A 8000 é a API direta, mantida
# para PDVs já configurados em http://IP:8000/api/v1.
HTTP_PORT=80
BACKEND_PORT=8000

# Uma máquina modesta dentro do restaurante. Aumente se o host tiver folga.
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
POSTGRES_POOL=True
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=8

# Sincronização: lote, retenção (só apaga o que a nuvem JÁ confirmou) e teto de
# arquivo por transferência.
SYNC_BATCH_MAX_EVENTS=200
SYNC_BATCH_MAX_BYTES=1048576
SYNC_RETENTION_DAYS=30
SYNC_INTERVAL=2
SYNC_HEARTBEAT=20
SYNC_FILE_MAX_BYTES=67108864
SYNC_METRICS_TOKEN=

# Mídia: vazio = disco local (volume backend_media). As imagens descem da
# nuvem pelo canal de arquivos da sincronização.
AWS_STORAGE_BUCKET_NAME=

# Monitoramento de erros (opcional).
SENTRY_DSN=
