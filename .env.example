DJANGO_ENV=development
# Optional. If omitted, DJANGO_DEBUG=True selects development and False selects production.
# DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
USE_SQLITE_DATABASE=True
SQLITE_DB_NAME=db.sqlite3
USE_LOCAL_MEMORY_SERVICES=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=starchef
POSTGRES_USER=starchef
POSTGRES_PASSWORD=starchef
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend (Vite) — carregado desta raiz via `envDir` em frontend/vite.config.js.
# Apenas variaveis com prefixo VITE_ sao expostas ao bundle do frontend.
VITE_API_BASE_URL=http://localhost:8001/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (DRF) — usados em qualquer ambiente. Formato "N/period"
# (period: sec, min, hour, day). Deixe em branco para usar os defaults do código.
# THROTTLE_RATE_ANON=60/min            # requisições anônimas por IP
# THROTTLE_RATE_USER=2000/hour         # requisições por usuário autenticado
# THROTTLE_RATE_LOGIN=10/min           # tentativas de login por IP
# THROTTLE_RATE_TOKEN_REFRESH=30/min   # refresh de token
# THROTTLE_RATE_CASH_APPROVAL=10/min   # aprovacao de operacao de caixa
# THROTTLE_RATE_PUBLIC_MENU=600/min    # cardapio publico (IP compartilhado)

# Producao: veja .env.production.example para o conjunto completo (Sentry,
# gunicorn, TLS, cookies seguros).
