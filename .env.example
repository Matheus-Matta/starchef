# ─────────────────────────────────────────────────────────────────────────────
# StarChef — variáveis de PRODUÇÃO (VPS + docker-compose.yml)
# Copie para `.env` no servidor e preencha. NUNCA versione o `.env` real.
#   docker compose pull
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# Django ----------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
# Gere um segredo forte:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=TROQUE-POR-UM-SEGREDO-FORTE
DJANGO_ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
DJANGO_CORS_ALLOWED_ORIGINS=https://seu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
# Chave de uso unico exigida no assistente /admin/login/ antes do primeiro admin.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_FIRST_ACCESS_TOKEN=TROQUE-POR-UMA-CHAVE-ALEATORIA-FORTE

# TLS/proxy: o compose não tem nginx — quem termina TLS é um proxy reverso
# EXTERNO (nginx do host, Caddy, LB da nuvem etc., ver
# infra/reverse-proxy.example.conf) que precisa repassar X-Forwarded-Proto=https
# pro backend. Sem isso, todo request "não-https" (na visão do Django) é
# redirecionado em loop.
#
# Os 4 abaixo (redirect + cookies Secure) só fazem sentido com TLS de verdade
# na frente. Testando sem TLS ainda (ex.: via HTTP puro, antes de montar o
# proxy externo)? Ponha os 4 como False temporariamente — senão o redirect
# quebra todo acesso e os cookies Secure não são gravados pelo navegador em
# HTTP puro (login/admin não funcionam). Volte pra True assim que o TLS
# estiver de pé.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_AUTH_COOKIE_SECURE=True
DJANGO_AUTH_COOKIE_SAMESITE=Lax
# Domínio dos cookies (deixe vazio para host-only, ou ".seu-dominio.com").
DJANGO_AUTH_COOKIE_DOMAIN=

# Banco (Postgres) — SEM SQLite/local-memory em produção ------------------------
USE_SQLITE_DATABASE=False
USE_LOCAL_MEMORY_SERVICES=False
POSTGRES_DB=starchef
POSTGRES_USER=starchef
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Reutiliza conexoes e valida a conexao antes de cada request.
POSTGRES_CONN_MAX_AGE=600
POSTGRES_CONN_HEALTH_CHECKS=True

# Redis / Celery ---------------------------------------------------------------
# O Redis NÃO roda neste docker-compose (era um serviço `redis` bundled, mas
# em produção o Redis costuma ser compartilhado entre vários apps do mesmo
# servidor) — `backend`/`celery_worker`/`celery_beat` se conectam na rede
# externa `apps_net` (ver `networks:` no fim do docker-compose.yml) pra
# alcançar o container Redis de verdade pelo nome dele. Ajuste o host (depois
# do "@") nas 3 URLs abaixo pro nome/hostname real desse container, e a
# senha pra bater com o `--requirepass` configurado nele.
REDIS_URL=redis://:TROQUE-POR-UMA-SENHA-FORTE@redis:6379/0
CELERY_BROKER_URL=redis://:TROQUE-POR-UMA-SENHA-FORTE@redis:6379/1
CELERY_RESULT_BACKEND=redis://:TROQUE-POR-UMA-SENHA-FORTE@redis:6379/2
CELERY_CONCURRENCY=4

# Gunicorn (opcional; defaults calculados por CPU) -----------------------------
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100
# GUNICORN_LOG_LEVEL=info

# Portas publicadas por backend/frontend (opcional) ----------------------------
# Por padrão ficam só em loopback (127.0.0.1) — só o proxy reverso externo
# rodando no mesmo host alcança. Se esse proxy rodar em outra máquina, troque
# o *_BIND para 0.0.0.0 e restrinja o acesso via firewall/security group ao IP
# dele (o backend confia em X-Forwarded-Proto/X-Forwarded-For de quem se
# conectar nele, então essas portas não podem ficar abertas pra internet).
# BACKEND_BIND=127.0.0.1
# BACKEND_PORT=8000
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8080

# Rate limiting (DRF) — opcional, sobrescreve os defaults do código ------------
# THROTTLE_RATE_ANON=60/min
# THROTTLE_RATE_USER=2000/hour
# THROTTLE_RATE_LOGIN=10/min
# THROTTLE_RATE_TOKEN_REFRESH=30/min
# THROTTLE_RATE_PASSWORD_RESET=5/min
# THROTTLE_RATE_PASSWORD_RESET_CONFIRM=10/min
# THROTTLE_RATE_DEVICE_POLL=180/min
# THROTTLE_RATE_CASH_APPROVAL=10/min
# THROTTLE_RATE_PUBLIC_MENU=600/min

# Sentry (opcional; só ativa se SENTRY_DSN estiver preenchido) -----------------
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_PII=False

# Sentry do frontend (opcional; projeto separado do Sentry do backend acima) ---
# VITE_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/YYYY
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry do PDV Flutter Desktop (opcional; projeto separado dos dois acima) ----
# Lido pelo app nativo (não pelo Vite) — nome sem prefixo VITE_ de propósito,
# para não colidir com a variável SENTRY_DSN do backend no mesmo .env.
# PDV_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/ZZZZ

# Logs -------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# E-mail transacional ----------------------------------------------------------
FRONTEND_URL=https://localhost:5173
DJANGO_EMAIL_HOST=smtp.seu-provedor.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL=StarChef <no-reply@seu-dominio.com>
PASSWORD_RESET_TIMEOUT_MINUTES=30

# Frontend (Vite) — usado no build do bundle -----------------------------------
# Same-origin (recomendado): o proxy reverso externo deve mapear / pro
# frontend e /api,/ws pro backend no MESMO domínio — sem CORS e compatível com
# cookies httpOnly SameSite=Lax. Só troque por uma URL absoluta se a API ficar
# em outro domínio.
API_URL=https://api.starchef.com.br/api/v1

